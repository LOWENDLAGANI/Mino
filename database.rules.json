{
  "rules": {
    "admin": {
      ".read": false,
      "pinHash": {
        ".read": "auth != null",
        ".write": "!data.exists() && auth != null",
        ".validate": "newData.isString() && newData.val().length === 64"
      },
      "registry": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name','firstSeen','lastSeen']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid",
        "chats": {
          "$chatId": {
            ".validate": "newData.hasChildren(['id','title','createdAt','updatedAt','messages'])"
          }
        }
      }
    }
  }
}
