# ── Mino environment ─────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in what this deployment needs. Nothing here is
# required to *run* Mino — every provider is optional and the app degrades to a
# setup notice rather than crashing — but a mode with no key cannot answer.
#
# Values marked PUBLIC are embedded in the browser bundle by Next.js. They are
# public by design (they identify the project, not a person) and must never be
# treated as secrets. Everything else is read on the server only.

# ── Firebase — accounts, cloud history, and the admin console ────────────────
# Without these the app is local-first: chats live in this browser's IndexedDB
# and there is no account, no cloud history, no admin console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Models — one key per mode, each optional ─────────────────────────────────
# Auto uses whichever of these is configured and falls back across them in
# order. Code deliberately does NOT cross between vendors: it stays inside the
# Gemini family or reports that no model was reachable.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Web search ───────────────────────────────────────────────────────────────
# Powers the composer's Auto/On search modes. Without it search is unavailable.
TAVILY_API_KEY=

# ── Image generation ─────────────────────────────────────────────────────────
# Cloudflare Workers AI. Without these the composer's image mode shows a note.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Mino Azure — the Gradio Space on Hugging Face ────────────────────────────
# Optional. Serves Azure mode from Mino's own model rather than a vendor.
MINO_HF_SPACE=
MINO_HF_TOKEN=
MINO_HF_TIMEOUT_MS=
MINO_HF_PROMPT_BUDGET=

# ── Google tools — Calendar, Tasks, Sheets, Docs, Maps ───────────────────────
# Optional. Enables "what's on my calendar", "add a task", and similar.
# The redirect URI must be exactly {SITE_URL}/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Encrypts the consent cookie at rest. Any 32-byte hex string; rotating it
# invalidates existing connections, which is the intended way to force a
# reconnect. Generate with: openssl rand -hex 32
GOOGLE_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=

# ── Administrator ────────────────────────────────────────────────────────────
# The one address allowed into the console and exempt from the paywall. Must
# match the address hard-coded in database.rules.json or the rules will refuse
# every admin write.
MINO_ADMIN_EMAIL=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate a key pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# ── Deployment ───────────────────────────────────────────────────────────────
# The canonical origin. Required for correct share previews and the sitemap;
# without it Open Graph URLs resolve against localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Optional: shared rate limiting ───────────────────────────────────────────
# Leave both empty and the limiter runs per instance (resets on cold start,
# weaker under concurrency but zero setup). Set both and every instance shares
# one counter, so the limit actually means "per minute" across the deployment.
# Free tier at https://upstash.com is plenty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: error monitoring ───────────────────────────────────────────────
# Leave empty and Sentry is inert: the SDK initialises disabled, makes no
# network calls, and the build succeeds without it. Set the DSN and errors
# from both the browser and the server start being reported — with conversation
# content stripped, which is what the beforeSend hooks in sentry.*.config.ts
# enforce. The three SENTRY_* values below are only needed to upload source
# maps at build time, which is what makes a stack trace readable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
